{
	"name": "@joshuafolkken/game-kit",
	"version": "0.187.0",
	"keywords": [
		"svelte"
	],
	"files": [
		"dist",
		"eslint",
		"templates",
		"cspell",
		"svelte.config.js",
		"src/app.d.ts",
		"!dist/**/*.test.*",
		"!templates/tsconfig.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./eslint/game": "./eslint/game.js",
		"./cspell/game": "./cspell/game.yaml"
	},
	"imports": {
		"#scripts/*": "./scripts/*"
	},
	"bin": {
		"josh-game": "dist/scripts/josh-game.js"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local",
		"prepare": "pnpm prepare:gen && pnpm prepare:sync && pnpm prepare:lefthook && pnpm prepare:gh-packages",
		"prepare:gen": "[ ! -f wrangler.jsonc ] || pnpm gen",
		"prepare:sync": "svelte-kit sync || echo ''",
		"prepare:lefthook": "[ -n \"$CI\" ] || ! command -v lefthook >/dev/null 2>&1 || lefthook install",
		"prepare:gh-packages": "[ -n \"$CI\" ] || ! command -v tsx >/dev/null 2>&1 || tsx node_modules/@joshuafolkken/kit/scripts/fix-gh-packages.ts",
		"build:scripts": "pnpm exec esbuild scripts/josh-game.ts --bundle --platform=node --packages=external --outdir=dist/scripts/ --format=esm --banner:js='#!/usr/bin/env node'",
		"reconcile-templates": "tsx scripts/templates/reconcile-templates.ts",
		"prepack": "svelte-kit sync && svelte-package && pnpm run build:scripts && publint",
		"gen:pre": "node -e \"const fs=require('node:fs');const d='.svelte-kit/cloudflare';if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>f.startsWith('_worker.')&&fs.rmSync(d+'/'+f,{force:true}))\"",
		"gen": "pnpm gen:pre && wrangler types",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"josh": "josh",
		"size-limit": "size-limit"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/app-kit": "^0.71.0",
		"@joshuafolkken/kit": "1.63.0",
		"@playwright/test": "1.62.1",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
		"@size-limit/file": "^13.0.3",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"@types/node": "^26.2.0",
		"@types/three": "^0.185.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.10",
		"cspell": "^10.0.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"lefthook": "^2.1.10",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.23",
		"rollup-plugin-visualizer": "^7.0.1",
		"secretlint": "^13.0.4",
		"size-limit": "^13.0.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.120.0"
	},
	"peerDependencies": {
		"@joshuafolkken/app-kit": ">=0.38.0",
		"@threlte/core": ">=8.0.0",
		"@threlte/extras": ">=9.0.0",
		"svelte": "^5.0.0",
		"three": ">=0.180.0"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
			"onFail": "error"
		}
	},
	"size-limit": [
		{
			"path": "./dist/index.js",
			"limit": "500 kB"
		}
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js"
}
